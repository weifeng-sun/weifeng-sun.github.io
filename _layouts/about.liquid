---
layout: default
---

<div class="academic-home">
  <aside class="home-sidebar">
    {% if page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {%
        include figure.liquid loading="eager" path=profile_image_path class="home-profile-photo" alt=site.title
        cache_bust=true
      %}
    {% endif %}
    <h1 class="home-name">{{ site.title }}</h1>
    {% if page.profile.position %}<p class="home-position">{{ page.profile.position }}</p>{% endif %}
    {% if page.profile.affiliation %}<p class="home-affiliation">{{ page.profile.affiliation }}</p>{% endif %}

    <ul class="home-links">
      {% if page.profile.location %}
        <li><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>{{ page.profile.location }}</span></li>
      {% endif %}
      {% for link in page.profile.links %}
        <li>
          <i class="{{ link.icon }}" aria-hidden="true"></i>
          <a href="{{ link.url | relative_url }}" {% if link.external %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </aside>

  <article class="home-content">
    <section class="home-section home-intro">
      {{ content }}
    </section>

    {% if page.research %}
      <section class="home-section">
        <div class="section-heading">
          <h2>Research Interests</h2>
        </div>
        {% assign scholar = site.data.scholar %}
        {% comment %} Round down to a multiple of 5 strictly below the total, so "over N" stays true. {% endcomment %}
        {% assign paper_floor = site.data.publication_stats.papers | minus: 1 | divided_by: 5 | times: 5 %}
        {% capture citation_badge %}
          <a class="citation-badge" href="https://scholar.google.com/citations?user={{ scholar.user_id }}&hl=en" target="_blank" rel="noopener noreferrer" title="Google Scholar, updated {{ scholar.last_updated }}">
            <span class="citation-badge__label"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> citations</span>
            <span class="citation-badge__count">{{ scholar.citations }}</span>
          </a>
        {% endcapture %}
        <p class="research-intro">
          {{ page.research.intro | replace: '[papers]', paper_floor | replace: '[citations]', citation_badge }}
        </p>
        <ul class="research-list">
          {% for item in page.research.items %}
            <li><strong>{{ item.title }}:</strong> {{ item.text }}</li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if page.news %}
      <section class="home-section">
        <div class="section-heading">
          <h2>News</h2>
        </div>
        <ul class="news-list">
          {% for item in page.news %}
            <li>
              <time>{{ item.date }}</time>
              <span>{{ item.text }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-heading section-heading--link">
          <h2>Selected Publications</h2>
          <a href="{{ '/publications/' | relative_url }}">View all</a>
        </div>
        <p class="publication-note">† first author · ✰ co-first author · * corresponding author</p>
        <div class="featured-publications">
          {% include selected_papers.liquid %}
        </div>
      </section>
    {% endif %}

    {% if page.education or page.awards %}
      <div class="home-columns">
        {% if page.education %}
          <section class="home-section">
            <div class="section-heading">
              <h2>Experience &amp; Education</h2>
            </div>
            <ul class="timeline-list">
              {% for item in page.education %}
                <li>
                  <time>{{ item.period }}</time>
                  <span>{{ item.text }}</span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if page.awards %}
          <section class="home-section">
            <div class="section-heading">
              <h2>Awards</h2>
            </div>
            <ul class="timeline-list">
              {% for item in page.awards %}
                <li>
                  <time>{{ item.year }}</time>
                  <span>{{ item.text }}</span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      </div>
    {% endif %}
  </article>
</div>
